config *.visualizer.dataLinkVisualizer[*].displayLinks true
config *.visualizer.dataLinkVisualizer[0].nodeFilter "\"sensor* or controller\""
config *.visualizer.dataLinkVisualizer[1].*Color "\"blue\""
